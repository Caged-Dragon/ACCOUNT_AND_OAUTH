# Exact issuer for the CAGED_DRAGON Supabase Auth project.
CAGED_DRAGON_OIDC_ISSUER=https://gbeurqibcfvquacasofq.supabase.co/auth/v1
# Public OAuth client ID created for this product in Caged Dragon /admin.
CAGED_DRAGON_CLIENT_ID=
# Must exactly match the callback URI registered for the client.
CAGED_DRAGON_REDIRECT_URI=https://your-product.example.com/auth/callback
# Public origin of this product; used for same-origin logout protection.
PRODUCT_PUBLIC_ORIGIN=https://your-product.example.com
PORT=5556
# Keep Secure cookies on for HTTPS. Use 0 only for localhost development.
COOKIE_SECURE=1
