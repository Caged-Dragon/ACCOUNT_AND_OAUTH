# Copy to .env. Never commit .env. Values are intentionally blank until you provide them.

# --- Supabase: use the project named CAGED_DRAGON ---
# Project Settings > API: Project URL and Publishable key (legacy anon keys also work).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY: Project Settings > API Keys > secret key (or legacy service_role key).
# Never prefix this with NEXT_PUBLIC_ and never place it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public address of this login app ---
# No custom domain is required. Use your deployed https://*.vercel.app URL when deployed,
# or http://localhost:3000 for local development. Must be an origin, not a path.
PUBLIC_URL=http://localhost:3000

# SECRET, 64 hex characters. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same value after deployment: it encrypts one-time login handoffs and derives signing keys.
LOGIN_CODE_KEY=

# Email/password sign-in is always available. EMAIL_ENABLED only enables email password-reset
# and change-email features, so keep it off until SMTP is connected in Supabase.
EMAIL_ENABLED=0
# Phone OTP UI and endpoints stay off until Supabase Phone Auth + an SMS provider are configured.
SMS_ENABLED=0
# Development-only shortcut. Never enable this in production.
UNVERIFIED_SIGNUP=0

# Comma-separated confirmed email addresses permitted to open /admin.
# Account deletion affects the shared identity across products. Keep off until explicitly reviewed.
ALLOW_ACCOUNT_DELETION=0

# Authentication attempt limits (per 15 minutes): per IP and per email.
AUTH_RATE_LIMIT=15
AUTH_RATE_LIMIT_EMAIL=10
# Use database for multi-instance deployments; memory is suitable for one local instance.
RATE_LIMIT_STORE=memory

# Passkeys use the hostname in PUBLIC_URL by default. Set only for a deliberate RP ID override.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Caged Dragon

# Optional Cloudflare Turnstile public site key (also configure its secret in Supabase Auth).
TURNSTILE_SITE_KEY=

# Optional legal links. Displayed only when both are valid URLs.
TERMS_URL=
PRIVACY_URL=

PORT=3000
# Set to the number of trusted proxy hops only when running behind your own proxy.
# Vercel is detected automatically. Do not set this to a broad trust value.
TRUST_PROXY=
